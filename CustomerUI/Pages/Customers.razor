@page "/customers"
@inject HttpClient Http
@using CustomerUI.Services
@using CustomerUI.DTO
@inject CustomerService CustomerService

<PageTitle>Customers</PageTitle>

<h1>Customers</h1>

<!-- Search Form -->
<form class="d-flex mb-3" @onsubmit="SearchCustomer">
    <input class="form-control me-2" type="search" placeholder="Search by ID"
           aria-label="Search" @bind="SearchId">
    <button class="btn btn-outline-success" type="submit">Search</button>
</form>

@if (customers == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Customer ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in customers)
                {
                    <tr>
                        <td>@customer.CustomerId</td>
                        <td>@customer.FullName</td>
                        <td>@customer.Email</td>
                        <td>@customer.PhoneNumber</td>
                        <td>
                            <button class="btn btn-outline-danger" @onclick="() => DeleteCustomer(customer)">Delete</button>
                        </td>
                        <td>
                            <a class="btn btn-outline-warning" href="/update-customer/@customer.CustomerId">Update</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private ICollection<CustomerDTO>? customers;
    private string? SearchId;

    protected override async Task OnInitializedAsync()
    {
        customers = await CustomerService.GetCustomersAsync();
    }

    private async Task DeleteCustomer(CustomerDTO customer)
    {
        await CustomerService.DeleteCustomerAsync(customer);
        customers = await CustomerService.GetCustomersAsync(); // Refresh after delete
    }

    private async Task SearchCustomer()
    {
        if (!string.IsNullOrWhiteSpace(SearchId) && int.TryParse(SearchId, out int id))
        {
            var customer = await CustomerService.GetCustomerByIdAsync(id);
            if (customer != null)
            {
                customers = new List<CustomerDTO>();
                customers.Add(customer);
            }

            else
            {
                customers = new List<CustomerDTO>();
            }
        }
        else
        {
            customers = await CustomerService.GetCustomersAsync(); // Reset view if input is invalid
        }
    }
}
