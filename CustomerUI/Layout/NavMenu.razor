<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CustomerUI</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">

        <div class="nav-item ">
            <NavLink class="nav-link d-flex align-items-center" href="customers">
                <span class="bi bi-list-nested me-2" aria-hidden="true"></span> 
                <span>Customers</span>
            </NavLink>
        </div>

        <div class="nav-item  ">
            <NavLink class="nav-link d-flex align-items-center" href="create-customer" Match="NavLinkMatch.All">
                <span class="bi bi-plus-square-fill me-2" aria-hidden="true"></span>
                <span>Add Customer</span>
                
            </NavLink>
        </div>

        <div class="nav-item ">
            <NavLink class="nav-link d-flex align-items-center" href="update-customer">
                <span class="bi bi-pencil-square me-2" aria-hidden="true"></span>
                <span>  Update Customer </span>
            </NavLink>

        </div>
       
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
